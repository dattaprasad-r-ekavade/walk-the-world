{
  "name": "walk-the-world",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "prebuild": "node scripts/stamp-sw-revision.mjs",
    "build": "next build",
    "build:bench": "node scripts/build-bench.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm test && npm run build",
    "portfolio:check": "npm test && npm run build",
    "bench": "node scripts/bench-perf.mjs",
    "bench:s8": "node scripts/bench-s8-scale-matrix.mjs",
    "bench:s7": "node scripts/s7-tour.mjs",
    "fixtures:build": "node scripts/build-benchmark-fixtures.mjs",
    "fixtures:build:rome": "node scripts/build-osm-fixture.mjs",
    "bench:street": "node scripts/validate-street.mjs",
    "assets:build": "node scripts/build-assets.mjs",
    "assets:props": "node scripts/optimize-props.mjs",
    "assets:ktx2": "node scripts/build-ktx2.mjs",
    "assets:runtime-ktx2": "node scripts/build-runtime-ktx2.mjs",
    "assets:runtime-index": "node scripts/build-runtime-ktx2.mjs --reuse-existing",
    "assets:facades": "node scripts/build-facade-atlases.mjs",
    "assets:preview": "blender --background --python scripts/render-asset-audit.py",
    "overture-index": "node scripts/build-overture-index.mjs",
    "overture:upload-index": "node --env-file=.env.local scripts/upload-overture-manifest.mjs",
    "enrich": "node scripts/enrich-r2-cells.mjs",
    "seed": "node scripts/warm-cities.mjs https://walk-the-world-delta.vercel.app --state=warm-state.json --conc=2",
    "seed:direct": "node --env-file=.env.local scripts/seed-direct.mjs --upgrade",
    "seed:stage-refresh": "node --env-file=.env.local scripts/stage-city-refresh.mjs --group=Demo",
    "seed:stage-overture": "node scripts/stage-overture-enrichment.mjs",
    "seed:verify-refresh": "node scripts/verify-city-refresh-stage.mjs",
    "seed:upload-refresh": "node --env-file=.env.local scripts/upload-city-refresh-stage.mjs",
    "seed:demo": "node scripts/warm-cities.mjs https://walk-the-world-delta.vercel.app --group=Demo --conc=2",
    "seed:list": "node scripts/warm-cities.mjs --list",
    "seed:local": "node scripts/warm-cities.mjs http://localhost:3000 --state=warm-state.json --conc=1",
    "rehearse": "node scripts/rehearse-demo.mjs",
    "bench:prebuilt-cells": "node scripts/bench-prebuilt-cells.mjs",
    "cells:bake": "node scripts/build-prebuilt-cells.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@duckdb/node-api": "^1.4.5-r.1",
    "dotenv": "^16.4.0",
    "meshoptimizer": "1.3.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "ignore": "^5.3.2",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "sharp": "0.35.5",
    "tailwindcss": "^3.4.19",
    "vite": "8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "glob": "^10.5.0",
    "tar": "^7.5.19"
  }
}
